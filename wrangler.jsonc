{
  "name": "whyitlands",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Keep the variables and secrets set in the Cloudflare dashboard on every deploy.
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret settings. BREVO_API_KEY is a secret set in the Cloudflare dashboard.
  "vars": {
    "SENDER_EMAIL": "hello@whyitlands.com",
    "CONTACT_TO": "hello@whyitlands.com"
  },
  "observability": { "enabled": true }
}
